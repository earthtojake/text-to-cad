      "types": "./dist/consent/index.d.ts",
      "import": "./dist/consent/index.js"
    },
    "./update": {
      "types": "./dist/update/index.d.ts",
      "import": "./dist/update/index.js"
    },
    "./tab-store": {
      "types": "./dist/tab-store/index.d.ts",
      "import": "./dist/tab-store/index.js"
    },
    "./library": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./cad-viewer": {
      "types": "./dist/cad-viewer/index.d.ts",
      "import": "./dist/cad-viewer/index.js"
    },
    "./catalog": {
      "types": "./dist/cad-viewer/catalog.d.ts",
      "import": "./dist/cad-viewer/catalog.js"
    },
    "./links": {
      "types": "./dist/file-viewer/navigation/links.d.ts",
      "import": "./dist/file-viewer/navigation/links.js"
    },
    "./build-id": "./scripts/build-id.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",

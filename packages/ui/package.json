{
  "name": "@hardcore/ui",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "docs",
    "licenses",
    "scripts/drawing-assets.mjs",
    "scripts/drawing-assets.d.mts",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./file-viewer": {
      "types": "./dist/file-viewer/index.d.ts",
      "import": "./dist/file-viewer/index.js"
    },
    "./navigation": {
      "types": "./dist/file-viewer/navigation/index.d.ts",
      "import": "./dist/file-viewer/navigation/index.js"
    },
    "./loading-icon": {
      "types": "./dist/loading/LoadingIcon.d.ts",
      "import": "./dist/loading/LoadingIcon.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./primitives/*": {
      "types": "./dist/primitives/*.d.ts",
      "import": "./dist/primitives/*.js"
    },
    "./renderers/*": {
      "types": "./dist/renderers/*/index.d.ts",
      "import": "./dist/renderers/*/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./package.json": "./package.json",
    "./file-viewer/presentation": {
      "types": "./dist/file-viewer/presentation.d.ts",
      "import": "./dist/file-viewer/presentation.js"
    },
    "./file-viewer/empty": {
      "types": "./dist/file-viewer/empty.d.ts",
      "import": "./dist/file-viewer/empty.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./drawing": {
      "types": "./dist/drawing/index.d.ts",
      "import": "./dist/drawing/index.js"
    },
    "./drawing-assets": "./scripts/drawing-assets.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "lucide-react": "^1.45.0",
    "three": "0.186.0"
  },
  "dependencies": {
    "@betteroffice/fonts": "0.2.0",
    "class-variance-authority": "0.7.1",
    "radix-ui": "1.6.7",
    "@hardcore/core": "*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "@excalidraw/excalidraw": "0.18.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/node": "22.20.1",
    "@types/three": "^0.185.4",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "typescript": "5.9.3",
    "esbuild": "0.27.7",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "postcss": "^8.5.14",
    "tw-animate-css": "1.4.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "jsdom": "30.0.1",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "vite": "^8.3.0",
    "@babel/parser": "^8.0.5",
    "@babel/traverse": "^8.0.5"
  }
}

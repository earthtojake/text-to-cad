{
  "name": "@hardcore/ui",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./file-viewer": {
      "types": "./dist/file-viewer/index.d.ts",
      "import": "./dist/file-viewer/index.js"
    },
    "./navigation": {
      "types": "./dist/file-viewer/navigation/index.d.ts",
      "import": "./dist/file-viewer/navigation/index.js"
    },
    "./loading-icon": {
      "types": "./dist/loading/LoadingIcon.d.ts",
      "import": "./dist/loading/LoadingIcon.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./primitives/*": {
      "types": "./dist/primitives/*.d.ts",
      "import": "./dist/primitives/*.js"
    },
    "./renderers/*": {
      "types": "./dist/renderers/*/index.d.ts",
      "import": "./dist/renderers/*/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./package.json": "./package.json",
    "./clipboard": {
      "types": "./dist/lib/clipboard.d.ts",
      "import": "./dist/lib/clipboard.js"
    },
    "./renderers/code/editor": {
      "types": "./dist/renderers/code/editor/index.d.ts",
      "import": "./dist/renderers/code/editor/index.js"
    },
    "./renderers/cad/state": {
      "types": "./dist/renderers/cad/state.d.ts",
      "import": "./dist/renderers/cad/state.js"
    },
    "./renderers/cad/presentation": {
      "types": "./dist/renderers/cad/presentation.d.ts",
      "import": "./dist/renderers/cad/presentation.js"
    },
    "./renderers/cad/empty": {
      "types": "./dist/renderers/cad/empty.d.ts",
      "import": "./dist/renderers/cad/empty.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "lucide-react": "^1.39.0",
    "three": "0.185.1"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "0.7.1",
    "monaco-editor": "0.56.0",
    "radix-ui": "1.6.7",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "@hardcore/core": "*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/node": "22.20.1",
    "@types/three": "^0.185.4",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "typescript": "5.9.3",
    "esbuild": "0.25.12",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "postcss": "^8.5.14",
    "tw-animate-css": "1.4.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "jsdom": "30.0.1",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "vite": "7.3.6",
    "@babel/parser": "8.0.4",
    "@babel/traverse": "8.0.4"

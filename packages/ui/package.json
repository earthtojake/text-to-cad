{
  "name": "@text-to-cad/ui",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "docs",
    "scripts/build-id.mjs",
    "scripts/build-id.d.mts",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./file-viewer": {
      "types": "./dist/file-viewer/index.d.ts",
      "import": "./dist/file-viewer/index.js"
    },

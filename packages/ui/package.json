    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.5",
    "@types/three": "^0.186.0",
    "lucide-react": "1.59.0",

{
  "name": "cadgen-js",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "Reusable CAD render/viewer runtime for docs, CAD Viewer, and generated snapshot browser assets.",
  "exports": {
    ".": "./src/index.js",
    "./common/*": "./src/common/*",
    "./glb/*": "./src/lib/glb/*",
    "./lib/*": "./src/lib/*"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs"
  },
  "sideEffects": [
    "./src/common/headlessRenderEntry.js",
    "./src/common/render.html"
  ],
  "dependencies": {
    "meshoptimizer": "^1.2.0",
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}

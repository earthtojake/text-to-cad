      "kind": "part",
      "ref": "U3",
      "canonical": "#U3"
    },
    {
      "selector": "U3",
      "kind": "part",
      "ref": "U3",
      "canonical": "#U3",
      "why": "the hash is optional, as in STEP selectors"

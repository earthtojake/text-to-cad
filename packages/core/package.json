{
  "name": "@text-to-cad/core",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Reusable CAD render/viewer runtime for docs, CAD Viewer, and generated snapshot browser assets.",
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./common/*": "./dist/common/*",
    "./lib/*": "./dist/lib/*",
    "./package.json": "./package.json",
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt/index.js"
    },
    "./chunk-ids": "./scripts/chunk-ids.mjs",
    "./source-maps": "./scripts/source-maps.mjs",
    "./third-party-licenses": "./scripts/third-party-licenses.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": [
    "./dist/common/headlessRenderEntry.js"
  ],
  "dependencies": {
    "meshoptimizer": "^1.3.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "^0.186.0",
    "esbuild": "0.28.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "^1.64.1",
    "typescript": "5.9.3",
    "jsdom": "30.1.3"
  },
  "files": [
    "dist",
    "scripts/chunk-ids.mjs",
    "scripts/source-maps.mjs",
    "scripts/third-party-licenses.mjs",
    "docs",
    "README.md"
  ]
}

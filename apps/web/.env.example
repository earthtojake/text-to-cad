# CAD Viewer local development defaults.
# Run the dev server from a folder of models (outside apps/web), then open the printed URL:
# npm --prefix <checkout>/apps/web run dev -- --host 127.0.0.1
# http://127.0.0.1:5173/ -- a file opened there is /<its id>

# The interpreter that runs the backend `npm run dev` spawns (python -m cad_server.viewer):
# one with the server installed. Defaults to python3.
# VIEWER_PYTHON=<checkout>/.venv/bin/python
# Attach to an engine you started yourself instead of spawning one: its apiUrl, with its
# token (named outside VIEWER_, which Vite hands to the page).
# VIEWER_BACKEND_URL=http://127.0.0.1:3400
# CAD_ENGINE_TOKEN=<token>

# The file a build opens by default, by its absolute path.
# VIEWER_DEFAULT_FILE=/abs/path/part.step
# Override the default repo/release links.
# VIEWER_GITHUB_URL=https://github.com/<owner>/<repo>
# Override the default Discord community link.
# VIEWER_DISCORD_URL=https://discord.gg/<invite>
# VIEWER_ALLOWED_HOSTS=localhost,127.0.0.1

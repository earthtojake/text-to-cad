{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*.ts",
    "src/plugins/index.mjs",
    "src/plugins/*/manifest.mjs",
    "src/plugins/**/*.ts",
    "src/plugins/**/*.tsx",
    "tests/unit/renderer/**/*.ts",
    "tests/unit/renderer/**/*.tsx",
    "tests/unit/shared/frames.ts",
    "tests/browser/**/*.tsx",
    "tests/viewer-host.ts",
    "tests/setup-jsdom.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "allowSyntheticDefaultImports": true
  }
}

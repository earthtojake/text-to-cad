{
  "name": "@emdash/wire",
  "version": "1.0.0",
  "description": "Transport-agnostic live model and mutation primitives for Hardcore",
  "license": "Apache-2.0",
  "author": {
    "name": "Hardcore Contributors",
    "url": "https://github.com/amywork777/hardcore"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./rpc": {
      "development": "./src/rpc/index.ts",
      "types": "./dist/rpc.d.mts",
      "default": "./dist/rpc.mjs"
    },
    "./live": {
      "development": "./src/live/index.ts",
      "types": "./dist/live.d.mts",
      "default": "./dist/live.mjs"
    },
    "./state": {
      "development": "./src/state/index.ts",
      "types": "./dist/state.d.mts",
      "default": "./dist/state.mjs"
    },
    "./mobx": {
      "development": "./src/live/mobx/index.ts",
      "types": "./dist/mobx.d.mts",
      "default": "./dist/mobx.mjs"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./worker": {
      "development": "./src/worker/index.ts",
      "types": "./dist/worker.d.mts",
      "default": "./dist/worker.mjs"
    },
    "./worker/node": {
      "development": "./src/worker/node/index.ts",
      "types": "./dist/worker-node.d.mts",
      "default": "./dist/worker-node.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "example:state-kernel": "tsx examples/state-kernel/client.ts",
    "example:live-log": "tsx examples/live-log/client.ts",
    "example:event-stream": "tsx examples/event-stream/client.ts",
    "example:scope": "tsx examples/scope/client.ts",
    "example:mailbox": "tsx examples/mailbox/client.ts",
    "example:resource-cache": "tsx examples/resource-cache/client.ts",
    "example:cancellation": "tsx examples/cancellation/client.ts",
    "example:dedupe": "tsx examples/dedupe/server.ts",
    "example:job-contract": "tsx examples/job-contract/client.ts",
    "example:api-definition": "tsx examples/api-definition/inspect.ts",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@emdash/shared": "workspace:*",
    "immer": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "mobx": "^6.16.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "mobx": "^6.16.1"
  }
}

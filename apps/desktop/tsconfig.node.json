{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/main/**/*.ts",
    "src/main/**/*.mjs",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/plugins/**/*.mjs",
    "tests/unit/main/**/*.ts",
    "tests/unit/shared/**/*.ts",
    "tests/e2e/**/*.ts",
    "scripts/**/*.mjs",
    "resources/hardcore-mcp/**/*.mjs",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  }
}

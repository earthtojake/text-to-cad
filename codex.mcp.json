{
  "mcpServers": {
    "cad": {
      "command": "uvx",
      "args": [
        "--no-config",
        "--managed-python",
        "--python",
        "3.14",
        "--from",
        "cad-mcp==0.10.3",
        "cad-mcp"
      ],
      "startup_timeout_sec": 300,
      "env": {
        "CAD_INSTALL_CHANNEL": "codex-github"
      }
    }
  }
}

{
  "mcpServers": {
    "cad": {
      "command": "uvx",
      "args": [
        "--no-config",
        "--managed-python",
        "--python",
        "3.13",
        "--from",
        "cadgen==0.7.12",
        "cadgen",
        "mcp"
      ],
      "startup_timeout_sec": 300,
      "env": {
        "CADGEN_INSTALL_CHANNEL": "codex-github"
      }
    }
  }
}

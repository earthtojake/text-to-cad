# macOS
.DS_Store
.vscode
/.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.python-version

# Local secrets: environment files, keys and certificates are never committed (an example
# file that names the variables, with no values, is).
.env
.env.*
!.env.example
*.pem
*.key

# Local environments and caches
.venv
.cache
.agents/
.vite
.vercel
node_modules
dist
coverage

# Playwright's per-run output.
test-results/

# Temporary files and scratch notes
*.tmp
*.swp
*.step.glb.lock
*.stp.glb.lock
tmp/
repo-scan*.md
*-scan-*.md
*-fix-plan*.md

# Benchmark output is local evidence, not source. Use tmp/ for reports.
/scripts/bench/**/results/
/scripts/bench/**/*.json
# ...but a benchmark's inputs are source: the corpus batch's models and the old engine's numbers.
!/scripts/bench/corpus.json
!/scripts/bench/old-engine-numbers.json
/scripts/bench/**/*.log
/scripts/bench/**/*.gz
/scripts/bench/**/*.cpuprofile
/scripts/bench/**/*.heapsnapshot
/scripts/bench/**/*.png

# Review media rendered next to a fixture. models/ holds CAD/robot sources and docs
# only; see models/README.md.
models/**/*.png
models/**/*.jpg
models/**/*.jpeg
models/**/*.gif
models/**/*.webp
models/**/*.avif
models/**/*.bmp
models/**/*.tif
models/**/*.tiff
models/**/*.svg
models/**/*.mp4
models/**/*.mov
models/**/*.webm
models/**/*.mkv

# models/ holds sources only. A run writes nothing; each project's own .gitignore keeps out
# the files written on request (STEP/ STL/ GLB/ 3MF/ DXF/, and the PDF/ of an @eng_drawing).
# An xbf saved by hand lands where it was asked to.
models/**/XBF/
# tom's vendor STEP inputs (536 MB, tom-cad's read-only data): a local copy, never committed.
models/tom/STEP/
# The unported models' frozen inputs and generated validation output (tendon_hand's
# palm and native hand, 8.5 MB and 250 MB), wherever someone restores them.
models/*/unported/STEP/
models/*/unported/validation/

# Component-GLB render packages are regenerated on demand; never committed.
.*.step.glb/
.*.step.glb
.*.stp.glb/
.*.stp.glb

# `python -m build` scratch space (scripts/release/check-wheel-contents.sh).
packages/cadgen/build/

# cadgen's packaged runtime: the headless snapshot bundle (browser/), the CAD
# Viewer's built client (viewer/), the CAD app (mcp/) and the file tracers
# (native/). All are BUILT by `scripts/bundle/bundle.sh` and shipped only inside the
# wheel; none of them is committed. A fresh checkout has no _runtime until the
# bundler runs, and cadgen says so by name when it needs one that is absent.
packages/cadgen/src/cadgen/_runtime/

# Design notes are local working files, never committed (user policy 2026-08-29).
design/

# Model-side source sidecars are regenerated by the model script (they carry
# a build timestamp, so committing them would churn); a fresh checkout
# restores pose/mates by running the script once.
*.source.json

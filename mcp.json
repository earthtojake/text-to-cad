{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cad": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--no-config",
        "--managed-python",
        "--python",
        "3.14",
        "--from",
        "texttocad-mcp==0.9.0",
        "cad-mcp"
      ],
      "env": {
        "CAD_INSTALL_CHANNEL": "agent-plugins"
      }
    }
  }
}

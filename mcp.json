{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cad": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--no-config",
        "--managed-python",
        "--python",
        "3.13",
        "--from",
        "cadgen==0.7.17",
        "cadgen",
        "mcp"
      ],
      "env": {
        "CADGEN_INSTALL_CHANNEL": "agent-plugins"
      }
    }
  }
}

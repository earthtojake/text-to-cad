{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAD Visual Inspection",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "p0": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "visual_basis": {
            "type": "string",
            "minLength": 1
          },
          "construction_implication": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "region",
          "observation",
          "visual_basis",
          "construction_implication",
          "confidence",
          "views"
        ],
        "additionalProperties": false
      },
      "maxItems": 5
    },
    "p1": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "visual_basis": {
            "type": "string",
            "minLength": 1
          },
          "construction_implication": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "region",
          "observation",
          "visual_basis",
          "construction_implication",
          "confidence",
          "views"
        ],
        "additionalProperties": false
      },
      "maxItems": 5
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "views": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "question",
          "reason",
          "views"
        ],
        "additionalProperties": false
      },
      "maxItems": 5
    }
  },
  "required": [
    "schema_version",
    "p0",
    "p1",
    "unknown"
  ],
  "additionalProperties": false
}

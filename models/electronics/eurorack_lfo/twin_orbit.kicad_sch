  (rectangle (start 12.7 20.32) (end 284.48 177.8) (stroke (width 0.254) (type dash) (color 72 72 72 1)) (fill (type none)) (uuid "82a4dc43-6202-5c81-a917-3eee028a2c4b"))
  (text "TWIN ORBIT: two exponential OTA LFOs, one sheet used twice" (exclude_from_sim no) (at 13.97 24.13 0) (effects (font (size 1.778 1.778) (bold yes)) (justify left bottom)) (uuid "5fcf804a-16b7-5424-b683-d9d1df918342"))
  (text "Each LFO: a PNP exponential current source sets an LM13700 OTA's bias current (RATE pot + CV);" (exclude_from_sim no) (at 38.1 106.68 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "19bcdc2a-1092-526b-8d65-dc6039be85a6"))
  (text "the OTA, switched by the square, charges 100 nF C0G with +-Iabc into a triangle, a TL074" (exclude_from_sim no) (at 38.1 111.76 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "72c69561-6fe2-5fca-a5b9-5e4a2d487029"))
  (text "buffers it and a Schmitt trigger squares it (clamped to +-5.8 V). SHAPE crossfades TRI and SQR." (exclude_from_sim no) (at 38.1 116.84 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "08cff8c8-fe72-5062-87fa-49119b103bfd"))
  (text "Rates 0.013 Hz to 80 Hz; outputs TRI +-4.9 V, SQR +-5.8 V, MIX between them, 1 k each." (exclude_from_sim no) (at 38.1 121.92 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "d6e4b896-fb4e-5727-8a94-e2e35c27a2e6"))
  (text "Power: Eurorack 10-pin, SS14 reverse protection, ferrites, 10 uF bulk per rail; about 25 mA each rail." (exclude_from_sim no) (at 38.1 127 0) (effects (font (size 1.778 1.778)) (justify left bottom)) (uuid "29abcf95-7ea5-57b2-9409-e7d32799288c"))

# Files written on request (cad <type> export, exports.py): reproducible from the code.
/STEP/
/STL/
/GLB/
/3MF/
/DXF/
/tmp/
__pycache__/
# The board's fabrication outputs (cad kicad_pcb export, cad kicad_sch export).
/fab/
# The 3D models src/footprint_models.py writes for the footprints that name them (${KIPRJMOD}/3dmodels).
/3dmodels/
# KiCad's local settings beside a board it opened.
*.kicad_prl
fp-info-cache
# The KiCad project build.py writes (cad run build.py): build output, made again from scripts/. The project
# file, twin_orbit.kicad_pro, is the source of the rules and netclasses: no script writes it.
/twin_orbit.kicad_pcb
/twin_orbit.kicad_sch
/lfo.kicad_sch
/power.kicad_sch
/twin_orbit.pretty/
/fp-lib-table
/sym-lib-table

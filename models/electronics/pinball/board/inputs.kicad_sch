	(text "THE BALL IS THE SWITCH: 18 gold combs, the steel ball shorts SENSE to GND"
		(exclude_from_sim no)
		(at 26.67 29.21 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7fed8ac6-7e6f-5096-9247-81956cd3cfb4")
	)
	(text "A comb's fingers are 0.4 mm on a 0.8 mm pitch; the 8 mm ball sags 5 um, less than the copper's 35 um, so it\ntouches both nets. The combs are exposed metal: at each comb's land a TVS clamps a strike to ground and a 1k beside it\nlimits what reaches the RP2040's pin, whose internal pull-up holds the line. SENSE_* is the comb's side, IN_* the pin's."
		(exclude_from_sim no)
		(at 27.94 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "61d4c390-f258-5dab-b893-34d5df23b330")
	)

(version 2)
# [diff_pair_gap_out_of_range], [diff_pair_uncoupled_length_too_long], [skew_out_of_range]: USB full
# speed, whose 83 ns bits are deaf to millimetres. The pair runs 0.25 mm apart; the receptacle's
# 0.5 mm pads spread its fanout to 0.4 mm. Its uncoupled length is the receptacle's B6 and B7 joins
# and the ESD diode's two taps (3.5 mm); its skew is B6's hop, two vias counted at board height (3.8 mm).
(rule "USB pair"
  (constraint diff_pair_gap (min 0.2mm) (opt 0.25mm) (max 0.4mm))
  (constraint diff_pair_uncoupled (max 4mm))
  (constraint skew (max 4mm) (within_diff_pairs))
  (condition "A.inDiffPair('D')"))
# [hole_clearance] holes to copper; the board's own floor, 0.15 mm, is the receptacle's alone
(rule "hole clearance"
  (constraint hole_clearance (min 0.25mm)))
# GCT's land pattern puts the receptacle's pads 0.17 mm from its own locating pegs
(rule "J1 land pattern"
  (constraint hole_clearance (min 0.15mm))
  (condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')"))
# the receptacle's ground pads and shell tabs sit too close together for spokes: solid to the pours
(rule "J1 solid to pour"
  (constraint zone_connection solid)
  (condition "A.memberOfFootprint('J1') && A.NetName == 'GND'"))
# [track_angle] bends at 45 or 90 degrees, none acute
(rule "no acute bends"
  (constraint track_angle (min 90))
  (condition "A.Type == 'Track'"))

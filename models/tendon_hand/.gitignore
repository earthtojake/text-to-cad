# the models read the sibling back through lib.embedded_animation at build time.
/src/*_animation.js

# Generated presentation assets. The HTML and its behavior test are source.
/website/*.glb
/website/*.mp4
/website/*.gif

# Snapshots, logs, checkpoints, and local review packets.
/tmp/

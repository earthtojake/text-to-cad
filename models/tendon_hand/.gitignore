# Generated geometry and document metadata.
/STEP/**/*.step
/STEP/**/*.stp
/STEP/**/*.stl
/STEP/**/*.3mf
/STEP/**/*.glb
/STEP/**/*.json

# Generated animation modules. The choreography is solved by

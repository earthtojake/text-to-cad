{
 "contract": {
  "install": [
   "--from",
   "cad-server==9.9.9",
   "cad",
   "setup",
   "--add",
   "--quiet"
  ],
  "setup": [
   "setup",
   "--engine-update"
  ],
  "marker": "versions/<version>/code/cad-version.json",
  "marker_keys": [
   "cad",
   "prefix",
   "python",
   "schema",
   "version"
  ],
  "marker_schema": "cad version/1"
 },
 "daemon": {
  "arguments": [
   "-P",
   "-m",
   "cad_server._internal.engine_daemon"
  ],
  "module": "cad_server._internal.engine_daemon"
 },
 "files": {
  "current": "installations/current",
  "current_bytes": "9.9.9",
  "record": "installations/<version>.json",
  "record_keys": [
   "cad",
   "prefix",
   "python",
   "registered",
   "version"
  ],
  "release_command": {
   "nt": "Scripts/cad.exe",
   "posix": "bin/cad"
  },
  "release_marker": "cad-release.json",
  "release_schema": "cad release/1",
  "releases": "releases",
  "token": "engines/token"
 },
 "http": {
  "server": {
   "route": "/api/v1/server",
   "status": 200,
   "type": "application/json; charset=utf-8",
   "keys": [
    "instance",
    "notice",
    "release",
    "update"
   ]
  },
  "page": {
   "route": "/<id>",
   "status": 200,
   "type": "text/html; charset=utf-8"
  },
  "app": {
   "route": "/app",
   "routed": true
  }
 },
 "ops": {
  "http": [
   "ok",
   "port",
   "token",
   "url"
  ],
  "status": [
   "installation",
   "ok",
   "pid",
   "prefix",
   "serving",
   "version"
  ],
  "stop_drain": {
   "draining": true,
   "ok": true
  }
 },
 "plugin": {
  "arguments": [
   "plugin",
   "--refresh"
  ],
  "flags": [
   "--help",
   "--json",
   "--refresh",
   "-h"
  ]
 },
 "progress": {
  "frame": [
   "detail",
   "done",
   "elapsedMs",
   "job",
   "kind",
   "outputs",
   "stage",
   "total"
  ],
  "kind": "update",
  "line": [
   "progress"
  ],
  "stages": [
   "install",
   "build123d",
   "restart",
   "apps"
  ]
 },
 "setup": {
  "command": "setup",
  "engine_update_flag": "--engine-update",
  "flags": [
   "--add",
   "--dry-run",
   "--engine-update",
   "--help",
   "--json",
   "--no-telemetry",
   "--only",
   "--quiet",
   "-h"
  ]
 },
 "update": {
  "command": "update",
  "flags": [
   "--dry-run",
   "--help",
   "--json",
   "--no-telemetry",
   "--only",
   "-h"
  ]
 }
}

{
 "daemon": {
  "arguments": [
   "-P",
   "-m",
   "cad_server._internal.engine_daemon"
  ],
  "module": "cad_server._internal.engine_daemon"
 },
 "files": {
  "current": "installations/current",
  "current_bytes": "9.9.9",
  "record": "installations/<version>.json",
  "record_keys": [
   "cad",
   "prefix",
   "python",
   "registered",
   "version"
  ],
  "release_command": {
   "nt": "Scripts/cad.exe",
   "posix": "bin/cad"
  },
  "release_marker": "cad-release.json",
  "release_schema": "cad release/1",
  "releases": "releases",
  "token": "engines/token"
 },
 "http": {
  "server": {
   "route": "/api/v1/server",
   "status": 200,
   "type": "application/json; charset=utf-8",
   "keys": [
    "instance",
    "release"
   ]
  },
  "page": {
   "route": "/<id>",
   "status": 200,
   "type": "text/html; charset=utf-8"
  },
  "app": {
   "route": "/app",
   "routed": true
  }
 },
 "ops": {
  "http": [
   "ok",
   "port",
   "token",
   "url"
  ],
  "status": [
   "installation",
   "ok",
   "pid",
   "prefix",
   "serving",
   "version"
  ],
  "stop_drain": {
   "draining": true,
   "ok": true
  }
 },
 "setup": {
  "command": "setup",
  "engine_update_flag": "--engine-update",
  "prepare_env": "CAD_UPDATE_PREPARE",
  "flags": [
   "--engine-update",
   "--help",
   "-h"
  ]
 },
 "update": {
  "build": [
   "UV",
   "tool",
   "run",
   "--isolated",
   "--managed-python",
   "--python",
   "3.14",
   "--from",
   "cad@latest",
   "cad",
   "--version"
  ],
  "entry": [
   "UV",
   "tool",
   "run",
   "--isolated",
   "--managed-python",
   "--python",
   "3.14",
   "--from",
   "cad==9.9.9",
   "python",
   "-P",
   "-m",
   "cad_server._internal.auto_update_helper"
  ],
  "told": [
   "asked",
   "at",
   "cad",
   "from",
   "installer",
   "log",
   "pipx",
   "prefix",
   "record",
   "spare",
   "start",
   "target",
   "tries",
   "uv",
   "wanted"
  ],
  "record": [
   "asked",
   "at",
   "beat",
   "from",
   "installer",
   "outcome",
   "phase",
   "release",
   "tries",
   "wanted"
  ],
  "phases": [
   "repairing",
   "switching"
  ],
  "notices": "/notices"
 }
}

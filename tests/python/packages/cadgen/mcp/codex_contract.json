   "content": [
    {
     "text": "<tmp>/project/parts/bracket.stl is open in a new CAD tab. From now on, use cad_show to show models in it.",
     "type": "text"
    }
   ],
   "structuredContent": {
    "launch": {
     "explore": true,
     "model": "<tmp>/project/parts/bracket.stl",
     "page": "viewer",
     "protocol": 2,
     "root": {
      "kind": "workspace",
      "name": "project",
      "path": "<tmp>/project"
     },
     "surface": "agent"
    }
   }
  },
  "cad_screenshot": {
   "content": [
    {
     "text": "No CAD viewer with a model is open in this thread. Open one with cad_open, or render headless with `cadgen snapshot`.",
     "type": "text"
    }
   ],
   "isError": true
  },
  "cad_show": {
   "content": [
    {
     "text": "No CAD viewer is open in this thread. Call cad_open to open one.",

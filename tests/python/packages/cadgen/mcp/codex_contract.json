    {
     "text": "bracket.stl is open in CAD.",
     "type": "text"
    }
   ],
   "structuredContent": {
    "launch": {
     "explore": false,
     "model": "<tmp>/project/parts/bracket.stl",
     "page": "viewer",
     "protocol": 2,
     "root": {
      "kind": "global",
      "name": "/",
      "path": "/"
     },
     "surface": "file"
    }
   }
  },

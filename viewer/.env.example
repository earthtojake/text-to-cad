# CAD Viewer local development defaults.
# Start the dev server from this directory, then open the printed URL with the
# absolute directory to browse as the URL path:
# npm run dev -- --host 127.0.0.1
# http://127.0.0.1:3245/absolute/model/root?file=path/relative/to/that/root

# Optional local settings.
# VIEWER_DEFAULT_DIR=/absolute/path/to/models
# VIEWER_DEFAULT_FILE=assemblies/robot-arm/robot-arm.step
# Override the default repo/release links.
# VIEWER_GITHUB_URL=https://github.com/<owner>/<repo>
# Override the default Discord community link.
# VIEWER_DISCORD_URL=https://discord.gg/<invite>
# VIEWER_ALLOWED_HOSTS=localhost,127.0.0.1
# VIEWER_MOVEIT2_WS_URL=ws://127.0.0.1:8765
# VIEWER_CAD_PYTHON=./.venv/bin/python
# VIEWER_CAD_PYTHONPATH=packages/cadgen/src
# VIEWER_SERVER_REGISTRY=/tmp/cad-viewer-servers.json
